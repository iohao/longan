{
  "name": "longan",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "bash -c 'lsof -ti:13000 | xargs -r kill -9 2>/dev/null; bun run tauri dev'",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "typecheck": "vue-tsc --build",
    "desktop": "tauri",
    "tauri": "tauri",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bash scripts/package-app.sh",
    "build:manifest": "bun scripts/build-updater-manifest.mjs",
    "check-i18n": "bun scripts/check-i18n.ts"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "^1.85.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
