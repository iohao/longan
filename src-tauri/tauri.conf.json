{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "longan",
  "version": "1.0.1",
  "identifier": "com.ionet.longan",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:13000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Longan",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCOTE5RUY5MUQ2NzI5QUMKUldTc0tXY2QrWjZSdTNOemltdjRYVWkyYndiUm1wK1NUSUJxNitOZU05aWNzQUlsN1QwRXdxbUMK",
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/iohao/longan@release-manifest/latest.json",
        "https://github.com/iohao/longan/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/iohao/longan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
